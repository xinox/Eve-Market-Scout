# --- Collector runtime config ---
# "json" writes local snapshot files under ./data (good for local dev / first run).
# "http" POSTs batches to the ingest-api Worker (production mode, Phase 1.2+).
STORAGE_MODE=json

# Required when STORAGE_MODE=http
INGEST_API_URL=https://eve-market-scout-ingest.<your-subdomain>.workers.dev/ingest
INGEST_API_SECRET=replace-with-a-long-random-string

# Optional: enables Discord alerts (Phase 1.4)
DISCORD_WEBHOOK_URL=

# ESI asks every client to identify itself. Put a way to contact you.
# See https://developers.eveonline.com/applications
ESI_USER_AGENT="eve-market-scout/0.1 (contact: your-email-or-github@example.com)"

# ESI versions its whole API by date instead of per-route URL versions.
# Pin this once you've reviewed a given date's behavior in the changelog;
# leave unset to default to "yesterday in UTC" (see esi-client/src/http.ts).
# https://developers.eveonline.com/docs/services/esi/overview/
ESI_COMPATIBILITY_DATE=

# --- Structure market collector (optional module, npm run collect:structures) ---
# Only needed if config/structures.json is non-empty. See
# packages/eve-sso/README.md for the one-time setup (register an app,
# run the login script once to obtain EVE_REFRESH_TOKEN).
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=https://localhost/callback
EVE_REFRESH_TOKEN=
