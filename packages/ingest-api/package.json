{
  "name": "@eve-market-scout/ingest-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "secret:set": "wrangler secret put INGEST_SECRET",
    "secret:set:github": "wrangler secret put GITHUB_ACTIONS_TOKEN"
  },
  "dependencies": {
    "@eve-market-scout/shared": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "wrangler": "^4.123.0"
  }
}
